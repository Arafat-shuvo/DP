verfitting)\nIN_CHANNELS = 4               # FLAIR, T1, T1ce, T2\nOUT_CHANNELS = 3              # WT, TC, ET\nEPOCHS = 200\nPATIENCE = 15                 # early stopping\nBATCH_SIZE = 32               # lower to 16 if you hit OOM\nLR = 1e-3                     # Adadelta learning rate\nWEIGHT_DECAY = 1e-3\nRLROP_FACTOR = 0.5            # ReduceLROnPlateau\nRLROP_PATIENCE = 4\nMIN_LR = 1e-7\nNUM_WORKERS = 2\nTIME_BUDGET_HOURS = 8.5       # whole notebook; keep below the Kaggle session limit\nFORCE_RERUN = False           # True = ignore finished seeds found in OUT_DIR\n\nMODEL_NAME = \"U-Net++\"\nOPTIMIZER = \"Adadelta\"\nEXP_TAG = \"\".join(c for c in f\"{MODEL_NAME}_{OPTIMIZER}\".replace(\" \", \"\") if c.isalnum() or c in \"_-\")\nDEADLINE = START_TIME + TIME_BUDGET_HOURS * 3600\n\nMODALITIES = [\"flair\", \"t1\", \"t1ce\", \"t2\"]\nREGIONS = [\"WT\", \"TC\", \"ET\"]\nDISK_DTYPE = np.float16 if STORE_FLOAT16 else np.float32\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s); torch.manual_seed(s)\n    if torch.cuda.is_available(): torch.cuda.manual_seed_all(s)\n\nset_seed(POOL_SEED)\nos.makedirs(OUT_DIR, exist_ok=True)\n\nprint(\"torch\", torch.__version__)\nprint(f\"Pool: {NUM_PATIENTS} patients, re-split per seed -> {1-VAL_FRAC-TEST_FRAC:.0%} train / {VAL_FRAC:.0%} val / {TEST_FRAC:.0%} test | seeds {SEEDS}\")\nprint(f\"img={IMG_SIZE} | batch={BATCH_SIZE} | base_filters={BASE_FILTERS} | epochs<={EPOCHS} (patience {PATIENCE}) | LR={LR} | wd={WEIGHT_DECAY}\")\nprint(f\"Model={MODEL_NAME} | Optimizer={OPTIMIZER} | Loss=Dice only | Metrics=Dice/IoU/Precision/Recall/HD95\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:25:59.953552Z","iopub.execute_input":"2026-10-24T18:25:59.954059Z","iopub.status.idle":"2026-10-24T18:26:08.965424Z","shell.execute_reply.started":"2026-10-24T18:25:59.954023Z","shell.execute_reply":"2026-10-24T18:26:08.964759Z"}},"outputs":[{"name":"stdout","text":"torch 2.11.0+cu128\nPool: 250 patients, re-split per seed -> 60% train / 20% val / 20% test | seeds [42, 43, 44]\nimg=128 | batch=32 | base_filters=32 | epochs<=200 (patience 15) | LR=0.001 | wd=0.001\nModel=U-Net++ | Optimizer=Adadelta | Loss=Dice only | Metrics=Dice/IoU/Precision/Recall/HD95\n","output_type":"stream"}],"execution_count":1},{"id":"91b4d55b-ed10-4c46-8f33-eddc7d938f46","cell_type":"markdown","source":"### GPU check\n**Output:** GPU name + real compute test.","metadata":{}},{"id":"75bae9cf-2027-4289-a00d-bad51dea1b13","cell_type":"code","source":"def get_device():\n    if not torch.cuda.is_available():\n        print(\"[warn] CUDA not available -> CPU (very slow). Enable it: Settings -> Accelerator -> GPU.\")\n        return torch.device(\"cpu\")\n    print(\"GPU:\", torch.cuda.get_device_name(0), \"(sm_%d%d)\" % torch.cuda.get_device_capability(0),\n          f\"| visible GPUs: {torch.cuda.device_count()} (training uses GPU 0)\")\n    _ = torch.randn(1024, 1024, device=\"cuda\") @ torch.randn(1024, 1024, device=\"cuda\")\n    torch.cuda.synchronize(); print(\"GPU compute test: OK\")\n    return torch.device(\"cuda\")\n\ndevice = get_device()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:26:08.966757Z","iopub.execute_input":"2026-10-24T18:26:08.967294Z","iopub.status.idle":"2026-10-24T18:26:09.472657Z","shell.execute_reply.started":"2026-10-24T18:26:08.967268Z","shell.execute_reply":"2026-10-24T18:26:09.472047Z"}},"outputs":[{"name":"stdout","text":"GPU: Tesla T4 (sm_75) | visible GPUs: 2 (training uses GPU 0)\nGPU compute test: OK\n","output_type":"stream"}],"execution_count":2},{"id":"d713657c-183d-4464-9cdd-c3076f6117da","cell_type":"markdown","source":"## 1. Load Dataset\nLooks for BraTS patient folders under `/kaggle/input`. If the dataset is shipped as `.tar` archives, only the first `NUM_PATIENTS` patients are unpacked to scratch space (saves time and disk).\n**Output:** number of patients.","metadata":{}},{"id":"5b27a616-5685-47df-9c27-834bdd4cd853","cell_type":"code","source":"WANTED_SUFFIX = tuple(f\"_{m}.nii.gz\" for m in MODALITIES + [\"seg\"])\n\ndef find_patient_dirs(root):\n    if not os.path.isdir(root):\n        return []\n    flairs = glob.glob(os.path.join(root, \"**\", \"*_flair.nii.gz\"), recursive=True)\n    return sorted({os.path.dirname(f) for f in flairs})\n\ndef extract_from_tars(root, out_dir, n):\n    \"\"\"Stream through the .tar file(s) and unpack only the first n patients (4 modalities + seg).\"\"\"\n    tars = sorted(glob.glob(os.path.join(root, \"**\", \"*.tar*\"), recursive=True))\n    got = []\n    for tp in tars:\n        print(\"Reading\", tp)\n        with tarfile.open(tp, \"r|*\") as tf:\n            for m in tf:\n                if not m.isfile() or not m.name.endswith(WANTED_SUFFIX):\n                    continue\n                pid = os.path.basename(m.name).rsplit(\"_\", 1)[0]\n                if pid not in got:\n                    if len(got) >= n:\n                        break\n                    got.append(pid)\n                dest = os.path.join(out_dir, pid, os.path.basename(m.name))\n                os.makedirs(os.path.dirname(dest), exist_ok=True)\n                with tf.extractfile(m) as src, open(dest, \"wb\") as dst:\n                    shutil.copyfileobj(src, dst)\n        if len(got) >= n:\n            break\n    print(f\"Unpacked {len(got)} patients to {out_dir}\")\n\npatients = find_patient_dirs(DATA_ROOT) or find_patient_dirs(RAW_DIR)\nif not patients:\n    extract_from_tars(DATA_ROOT, RAW_DIR, NUM_PATIENTS)\n    patients = find_patient_dirs(RAW_DIR)\nif not patients:\n    raise SystemExit(\"No BraTS NIfTI data found. Add a BraTS 2021 dataset via 'Add Input' (needs *_flair.nii.gz, *_t1.nii.gz, *_t1ce.nii.gz, *_t2.nii.gz, *_seg.nii.gz).\")\n\nprint(f\"Found {len(patients)} patients | will use {min(NUM_PATIENTS, len(patients))}\")\nprint(\"Example:\", os.path.basename(patients[0]))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:26:09.473624Z","iopub.execute_input":"2026-10-24T18:26:09.47395Z","iopub.status.idle":"2026-10-24T18:26:34.853784Z","shell.execute_reply.started":"2026-10-24T18:26:09.47393Z","shell.execute_reply":"2026-10-24T18:26:34.852824Z"}},"outputs":[{"name":"stdout","text":"Reading /kaggle/input/datasets/dschettler8845/brats-2021-task1/BraTS2021_00495.tar\nReading /kaggle/input/datasets/dschettler8845/brats-2021-task1/BraTS2021_00621.tar\nReading /kaggle/input/datasets/dschettler8845/brats-2021-task1/BraTS2021_Training_Data.tar\nUnpacked 250 patients to /kaggle/working/brats_raw\nFound 250 patients | will use 250\nExample: BraTS2021_00000\n","output_type":"stream"}],"execution_count":3},{"id":"7282022d-20af-402a-8a22-889671bd71d6","cell_type":"markdown","source":"## 2. Dataset structure & channels\n| Channel | Modality | Shows | Importance |\n|--------|----------|-------|-----------|\n| 0 | FLAIR | fluid-attenuated | whole tumor / edema |\n| 1 | T1 | anatomy | reference |\n| 2 | T1ce | contrast | enhancing tumor / core |\n| 3 | T2 | fluid-sensitive | edema / extent |\n| - | seg | labels 1/2/4 | ground-truth |\n\n**Output:** shapes, labels, one slice across channels.","metadata":{}},{"id":"ac3ce33a-18af-493e-8228-ebc923c55e98","cell_type":"code","source":"def load_vol(pdir, m):\n    pid = os.path.basename(pdir)\n    return nib.load(os.path.join(pdir, f\"{pid}_{m}.nii.gz\")).get_fdata().astype(np.float32)\n\ndemo = patients[0]; vols = {m: load_vol(demo, m) for m in MODALITIES}; seg = load_vol(demo, \"seg\")\nprint(\"Patient:\", os.path.basename(demo), \"| seg labels:\", np.unique(seg).astype(int).tolist())\nfor m in MODALITIES: print(f\"  {m:5s} {vols[m].shape}\")\nz = max(range(seg.shape[2]), key=lambda k: (seg[:, :, k] > 0).sum())\nfig, ax = plt.subplots(1, 5, figsize=(15, 3))\nfor j, m in enumerate(MODALITIES):\n    ax[j].imshow(vols[m][:, :, z], cmap=\"gray\"); ax[j].set_title(m); ax[j].axis(\"off\")\nax[4].imshow(seg[:, :, z], cmap=\"nipy_spectral\"); ax[4].set_title(\"seg\"); ax[4].axis(\"off\")\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:26:34.85492Z","iopub.execute_input":"2026-10-24T18:26:34.855419Z","iopub.status.idle":"2026-10-24T18:26:35.883854Z","shell.execute_reply.started":"2026-10-24T18:26:34.855397Z","shell.execute_reply":"2026-10-24T18:26:35.882772Z"}},"outputs":[{"name":"stdout","text":"Patient: BraTS2021_00000 | seg labels: [0, 1, 2, 4]\n  flair (240, 240, 155)\n  t1    (240, 240, 155)\n  t1ce  (240, 240, 155)\n  t2    (240, 240, 155)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x300 with 5 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":4},{"id":"cfbbcc18-689b-4410-8511-647f5904b6e5","cell_type":"markdown","source":"## 3. Preprocessing (channel-based) -> disk cache\nEach modality is z-scored independently on brain voxels; tumor slices + neighbours + a few empty slices are kept, resized, and written to `PROCESSED_DIR`. Runs once; reruns skip automatically.\n**Output:** per-channel normalisation check.","metadata":{}},{"id":"723a8987-e1be-4db4-8fce-3c125585faf1","cell_type":"code","source":"def znorm_channel(vol):\n    brain = vol > 0\n    if brain.sum() == 0: return vol\n    vol = (vol - vol[brain].mean()) / (vol[brain].std() + 1e-8); vol[~brain] = 0.0\n    return vol\n\ndef rz_img(sl): return cv2.resize(sl, (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_AREA)\ndef rz_msk(sl): return cv2.resize(sl.astype(np.uint8), (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_NEAREST)\n\ndef select_slices(seg, mods, Z):\n    brain_ok = [(mods[0][:, :, z] != 0).mean() >= MIN_BRAIN_FRACTION for z in range(Z)]\n    tumor = [z for z in range(Z) if brain_ok[z] and seg[:, :, z].max() > 0]\n    ctx = set()\n    for tz in tumor:\n        for dz in range(-NEIGHBOR_SLICES, NEIGHBOR_SLICES + 1):\n            zz = tz + dz\n            if 0 <= zz < Z and brain_ok[zz]: ctx.add(zz)\n    ctx -= set(tumor)\n    empties = [z for z in range(Z) if brain_ok[z] and z not in set(tumor) | ctx]\n    random.shuffle(empties); empties = empties[:int(len(empties) * KEEP_EMPTY_FRACTION)]\n    keep = list(tumor) + sorted(ctx) + empties\n    if MAX_SLICES_PER_PATIENT and len(keep) > MAX_SLICES_PER_PATIENT: keep = keep[:MAX_SLICES_PER_PATIENT]\n    return sorted(set(keep))\n\nprint(\"Channel-based normalisation (brain voxels):\")\nfor m in MODALITIES:\n    raw = vols[m]; b = raw > 0; nz = znorm_channel(raw.copy()); bn = nz != 0\n    print(f\"  {m:5s} raw {raw[b].mean():7.1f}/{raw[b].std():6.1f} -> norm {nz[bn].mean():5.2f}/{nz[bn].std():4.2f}\")\ndel vols, seg","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:26:35.886213Z","iopub.execute_input":"2026-10-24T18:26:35.886481Z","iopub.status.idle":"2026-10-24T18:26:36.659698Z","shell.execute_reply.started":"2026-10-24T18:26:35.88646Z","shell.execute_reply":"2026-10-24T18:26:36.658775Z"}},"outputs":[{"name":"stdout","text":"Channel-based normalisation (brain voxels):\n  flair raw   987.1/ 357.7 -> norm -0.00/1.00\n  t1    raw   802.2/ 171.7 -> norm  0.00/1.00\n  t1ce  raw  2084.0/ 837.9 -> norm  0.00/1.00\n  t2    raw   565.7/ 312.5 -> norm -0.00/1.00\n","output_type":"stream"}],"execution_count":5},{"id":"71c24201-43ac-4883-8f57-7d4d01b9c050","cell_type":"markdown","source":"### Build the slice cache for the whole pool (once)\nThe pool (fixed by `POOL_SEED`) is preprocessed once. Train/val/test membership is decided later, per seed, on the patient level.","metadata":{}},{"id":"cb8b1052-f405-475f-a1c7-49a8a9a83efa","cell_type":"code","source":"def select_pool(patient_dirs):\n    dirs = sorted(patient_dirs)\n    random.Random(POOL_SEED).shuffle(dirs)\n    return sorted(dirs[:NUM_PATIENTS])\n\ndef preprocess_to_disk(pool_dirs):\n    meta_path = os.path.join(PROCESSED_DIR, \"meta.json\")\n    pids = [os.path.basename(p) for p in pool_dirs]\n    if (not FORCE_PREPROCESS) and os.path.exists(meta_path):\n        meta = json.load(open(meta_path))\n        if meta.get(\"img_size\") == IMG_SIZE and sorted(meta.get(\"pool\", {})) == sorted(pids):\n            print(\"Found existing cache -> skipping preprocessing.\"); return meta[\"pool\"]\n    os.makedirs(img_dir, exist_ok=True); os.makedirs(msk_dir, exist_ok=True)\n    random.seed(POOL_SEED)\n    pool = {}\n    for pdir in tqdm(pool_dirs, desc=\"Preprocessing to disk\"):\n        pid = os.path.basename(pdir)\n        mods = [znorm_channel(load_vol(pdir, m)) for m in MODALITIES]\n        seg = load_vol(pdir, \"seg\"); Z = seg.shape[2]\n        sids = []\n        for z in select_slices(seg, mods, Z):\n            sid = f\"{pid}_z{z:03d}\"\n            img = np.stack([rz_img(m[:, :, z]) for m in mods], 0).astype(DISK_DTYPE)\n            s = seg[:, :, z]\n            mask = np.stack([rz_msk(np.isin(s, [1, 2, 4])), rz_msk(np.isin(s, [1, 4])), rz_msk(s == 4)], 0).astype(np.uint8)\n            np.save(os.path.join(img_dir, sid + \".npy\"), img); np.save(os.path.join(msk_dir, sid + \".npy\"), mask)\n            sids.append(sid)\n        pool[pid] = sids\n    json.dump({\"img_size\": IMG_SIZE, \"pool\": pool}, open(meta_path, \"w\"))\n    return pool\n\ndef make_splits(pool, seed):\n    \"\"\"Patient-wise split that depends only on the seed (identical across model notebooks).\"\"\"\n    pids = sorted(pool); random.Random(seed).shuffle(pids)\n    n = len(pids); n_val = round(n * VAL_FRAC); n_test = round(n * TEST_FRAC)\n    groups = {\"val\": pids[:n_val], \"test\": pids[n_val:n_val + n_test], \"train\": pids[n_val + n_test:]}\n    splits = {k: [sid for p in v for sid in pool[p]] for k, v in groups.items()}\n    return splits, {k: len(v) for k, v in groups.items()}\n\npool = preprocess_to_disk(select_pool(patients))\nn_sl = sum(len(v) for v in pool.values())\nper = 4 * IMG_SIZE * IMG_SIZE * (2 if STORE_FLOAT16 else 4) + 3 * IMG_SIZE * IMG_SIZE\nprint(f\"Pool: {len(pool)} patients, {n_sl} slices (~{n_sl/len(pool):.0f} per patient) ~ {n_sl*per/1e9:.1f} GB at {PROCESSED_DIR}\")\nfor sd in SEEDS:\n    sp, cnt = make_splits(pool, sd)\n    print(f\"  seed {sd}: patients {cnt['train']}/{cnt['val']}/{cnt['test']} -> slices {len(sp['train'])}/{len(sp['val'])}/{len(sp['test'])} (train/val/test)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:26:36.661021Z","iopub.execute_input":"2026-10-24T18:26:36.661318Z","iopub.status.idle":"2026-10-24T18:32:09.473301Z","shell.execute_reply.started":"2026-10-24T18:26:36.661297Z","shell.execute_reply":"2026-10-24T18:32:09.472653Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Preprocessing to disk:   0%|          | 0/250 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"7df4d1a0e0b74f55983387a6caafa0b3"}},"metadata":{}},{"name":"stdout","text":"Pool: 250 patients, 18368 slices (~73 per patient) ~ 3.3 GB at /kaggle/working/brats_processed\n  seed 42: patients 150/50/50 -> slices 11070/3725/3573 (train/val/test)\n  seed 43: patients 150/50/50 -> slices 11030/3686/3652 (train/val/test)\n  seed 44: patients 150/50/50 -> slices 11144/3589/3635 (train/val/test)\n","output_type":"stream"}],"execution_count":6},{"id":"bd24f689-9034-4d35-b4e6-b4e5fcd5f80a","cell_type":"markdown","source":"### Datasets + DataLoaders (synchronized augmentation)\nTrain-only: flips, 90-degree rotations, scale/zoom, gamma, intensity - applied identically to image and mask.\n`drop_last=True` on the train loader (BatchNorm with a batch of 1 would fail in ASPP; kept for all models so the recipe is identical).","metadata":{}},{"id":"1e6b2212-07c3-4571-a397-8c5375783660","cell_type":"code","source":"def _fix(a, H, W):\n    ch, nh, nw = a.shape; out = np.zeros((ch, H, W), a.dtype)\n    y0, x0 = max((nh - H) // 2, 0), max((nw - W) // 2, 0); oy, ox = max((H - nh) // 2, 0), max((W - nw) // 2, 0)\n    hh, ww = min(nh, H), min(nw, W); out[:, oy:oy + hh, ox:ox + ww] = a[:, y0:y0 + hh, x0:x0 + ww]; return out\n\ndef _scale(x, y, s):\n    H, W = x.shape[1:]; nh, nw = max(1, round(H * s)), max(1, round(W * s))\n    xr = np.stack([cv2.resize(x[c], (nw, nh), interpolation=cv2.INTER_LINEAR) for c in range(x.shape[0])], 0)\n    yr = np.stack([cv2.resize(y[c], (nw, nh), interpolation=cv2.INTER_NEAREST) for c in range(y.shape[0])], 0)\n    return _fix(xr, H, W), _fix(yr, H, W)\n\ndef _gamma(x, g):\n    m = x != 0\n    if m.sum() == 0: return x\n    v = x[m]; lo, hi = v.min(), v.max()\n    if hi > lo: x[m] = (np.clip((v - lo) / (hi - lo), 0, 1) ** g) * (hi - lo) + lo\n    return x\n\ndef augment(x, y):\n    if random.random() < 0.5: x = x[:, :, ::-1]; y = y[:, :, ::-1]\n    if random.random() < 0.5: x = x[:, ::-1, :]; y = y[:, ::-1, :]\n    k = random.randint(0, 3)\n    if k: x = np.rot90(x, k, (1, 2)); y = np.rot90(y, k, (1, 2))\n    x, y = np.ascontiguousarray(x), np.ascontiguousarray(y)\n    if random.random() < 0.5: x, y = _scale(x, y, random.uniform(0.85, 1.15))\n    if random.random() < 0.5: x = _gamma(x, random.uniform(0.7, 1.5))\n    x = x * random.uniform(0.9, 1.1) + random.uniform(-0.1, 0.1)\n    return x, y\n\nclass DiskSliceDS(Dataset):\n    def __init__(self, ids, aug=False): self.ids, self.aug = ids, aug\n    def __len__(self): return len(self.ids)\n    def __getitem__(self, i):\n        sid = self.ids[i]\n        x = np.load(os.path.join(img_dir, sid + \".npy\")).astype(np.float32)\n        y = np.load(os.path.join(msk_dir, sid + \".npy\")).astype(np.float32)\n        if self.aug: x, y = augment(x, y)\n        return torch.from_numpy(np.ascontiguousarray(x)), torch.from_numpy(np.ascontiguousarray(y))\n\ndef seed_worker(worker_id):\n    s = (torch.initial_seed() + worker_id) % 2**32\n    random.seed(s); np.random.seed(s)\n\n\ndef make_loaders(splits, seed):\n    g = torch.Generator(); g.manual_seed(seed)\n    pin = device.type == \"cuda\"\n    kw = dict(num_workers=NUM_WORKERS, pin_memory=pin, worker_init_fn=seed_worker, persistent_workers=NUM_WORKERS > 0)\n    tr = DataLoader(DiskSliceDS(splits[\"train\"], True), BATCH_SIZE, shuffle=True, drop_last=True, generator=g, **kw)\n    va = DataLoader(DiskSliceDS(splits[\"val\"], False), BATCH_SIZE, shuffle=False, **kw)\n    te = DataLoader(DiskSliceDS(splits[\"test\"], False), BATCH_SIZE, shuffle=False, **kw)\n    return tr, va, te\n\n# quick sanity check on the first seed\n_sp, _ = make_splits(pool, SEEDS[0]); _tl, _vl, _tel = make_loaders(_sp, SEEDS[0])\n_xb, _yb = next(iter(_tl)); print(\"Batch images:\", tuple(_xb.shape), \"| masks:\", tuple(_yb.shape))\ndel _sp, _tl, _vl, _tel, _xb, _yb; gc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:09.474415Z","iopub.execute_input":"2026-10-24T18:32:09.474738Z","iopub.status.idle":"2026-10-24T18:32:09.936946Z","shell.execute_reply.started":"2026-10-24T18:32:09.474717Z","shell.execute_reply":"2026-10-24T18:32:09.936256Z"}},"outputs":[{"name":"stdout","text":"Batch images: (32, 4, 128, 128) | masks: (32, 3, 128, 128)\n","output_type":"stream"},{"execution_count":7,"output_type":"execute_result","data":{"text/plain":"21"},"metadata":{}}],"execution_count":7},{"id":"ae4024e1-be3f-4670-ab19-461bcb93a8c7","cell_type":"markdown","source":"## U-Net++ (PyTorch)\nPlain U-Net++: nested, densely connected encoder-decoder (no SE / attention).","metadata":{}},{"id":"9bddf306-4cb5-4fe0-b56b-d0609e8e0cb5","cell_type":"code","source":"class ConvBlock(nn.Module):\n    \"\"\"Two 3x3 convolutions, each followed by BatchNorm and ReLU.\"\"\"\n    def __init__(self, cin, cout):\n        super().__init__(); self.net = nn.Sequential(\n            nn.Conv2d(cin, cout, 3, padding=1, bias=False), nn.BatchNorm2d(cout), nn.ReLU(True),\n            nn.Conv2d(cout, cout, 3, padding=1, bias=False), nn.BatchNorm2d(cout), nn.ReLU(True))\n    def forward(self, x): return self.net(x)\n\nclass UNetPP(nn.Module):\n    \"\"\"Plain U-Net++ : nested, densely-connected encoder-decoder (no SE / attention).\"\"\"\n    def __init__(self, in_ch=4, out_ch=3, base=64):\n        super().__init__(); self.pool = nn.MaxPool2d(2)\n        f = [base, base * 2, base * 4, base * 8, base * 16]\n        # encoder (plain conv blocks)\n        self.x00 = ConvBlock(in_ch, f[0]); self.x10 = ConvBlock(f[0], f[1]); self.x20 = ConvBlock(f[1], f[2])\n        self.x30 = ConvBlock(f[2], f[3]); self.x40 = ConvBlock(f[3], f[4])\n        # nested decoder nodes: plain conv blocks. input = j*f[i] (same-scale) + f[i+1] (upsampled)\n        self.dec = nn.ModuleDict({f\"x{i}{j}\": ConvBlock(j * f[i] + f[i + 1], f[i])\n                                  for j in range(1, 5) for i in range(0, 5 - j)})\n        self.out = nn.Conv2d(f[0], out_ch, 1)\n    def _up(self, x, ref):\n        return F.interpolate(x, size=ref.shape[-2:], mode=\"bilinear\", align_corners=False)\n    def forward(self, x):\n        X = {}\n        X[(0, 0)] = self.x00(x)\n        X[(1, 0)] = self.x10(self.pool(X[(0, 0)]))\n        X[(2, 0)] = self.x20(self.pool(X[(1, 0)]))\n        X[(3, 0)] = self.x30(self.pool(X[(2, 0)]))\n        X[(4, 0)] = self.x40(self.pool(X[(3, 0)]))\n        for j in range(1, 5):\n            for i in range(0, 5 - j):\n                feats = [X[(i, k)] for k in range(j)] + [self._up(X[(i + 1, j - 1)], X[(i, 0)])]\n                X[(i, j)] = self.dec[f\"x{i}{j}\"](torch.cat(feats, 1))\n        return self.out(X[(0, 4)])   # logits (sigmoid applied in loss/metrics)\n\ndef build_model():\n    return UNetPP(IN_CHANNELS, OUT_CHANNELS, BASE_FILTERS).to(device)\n\n_m = build_model()\nprint(\"=============== U-Net++ ===============\")\nprint(f\"Total parameters: {sum(p.numel() for p in _m.parameters())/1e6:.2f}M\")\nif HAS_TORCHINFO:\n    torchinfo_summary(_m, input_size=(1, IN_CHANNELS, IMG_SIZE, IMG_SIZE), col_names=(\"output_size\", \"num_params\"), depth=2)\ndel _m; gc.collect()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:09.93817Z","iopub.execute_input":"2026-10-24T18:32:09.938486Z","iopub.status.idle":"2026-10-24T18:32:11.101698Z","shell.execute_reply.started":"2026-10-24T18:32:09.938455Z","shell.execute_reply":"2026-10-24T18:32:11.100907Z"}},"outputs":[{"name":"stdout","text":"=============== U-Net++ ===============\nTotal parameters: 9.16M\n","output_type":"stream"},{"execution_count":8,"output_type":"execute_result","data":{"text/plain":"0"},"metadata":{}}],"execution_count":8},{"id":"a753db43-7b35-41ad-9987-4af79b264a29","cell_type":"markdown","source":"## Loss - Dice (only)\nAggregate soft Dice loss - no BCE term.\n**Output:** perfect prediction -> loss ~ 0.","metadata":{}},{"id":"d4003de9-b673-4dc0-a7ed-ba9d172c4b57","cell_type":"code","source":"class DiceLoss(nn.Module):\n    def forward(self, logits, y, eps=1e-6):\n        p = torch.sigmoid(logits.float())          # float32 even under mixed precision\n        inter = (p * y).sum(); denom = p.sum() + y.sum()\n        return 1 - (2 * inter + eps) / (denom + eps)\n\n_y = (torch.rand(2, 3, 32, 32) > 0.5).float()\nprint(\"Dice loss, perfect prediction:\", round(DiceLoss()((_y - 0.5) * 20, _y).item(), 4), \"(expect ~0)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:11.102722Z","iopub.execute_input":"2026-10-24T18:32:11.103107Z","iopub.status.idle":"2026-10-24T18:32:11.148456Z","shell.execute_reply.started":"2026-10-24T18:32:11.103085Z","shell.execute_reply":"2026-10-24T18:32:11.14787Z"}},"outputs":[{"name":"stdout","text":"Dice loss, perfect prediction: 0.0 (expect ~0)\n","output_type":"stream"}],"execution_count":9},{"id":"d323fba3-c27e-434f-8cdc-edd367bb0833","cell_type":"markdown","source":"## Metrics - Dice, IoU, Precision, Recall\nAccumulated over the whole set (micro-averaged), reported per region.\n**Output:** perfect prediction -> Dice = IoU = 1.","metadata":{}},{"id":"3951d376-0669-476d-bcd7-301d0bf6b58a","cell_type":"code","source":"@torch.no_grad()\ndef accumulate(logits, y, acc, thr=0.5):\n    p = (torch.sigmoid(logits) > thr).float()\n    acc[\"tp\"] += (p * y).sum((0, 2, 3)).cpu()\n    acc[\"fp\"] += (p * (1 - y)).sum((0, 2, 3)).cpu()\n    acc[\"fn\"] += ((1 - p) * y).sum((0, 2, 3)).cpu()\n    return acc\n\ndef new_acc(): return {\"tp\": torch.zeros(3), \"fp\": torch.zeros(3), \"fn\": torch.zeros(3)}\n\ndef metrics_from(acc, eps=1e-6):\n    tp, fp, fn = acc[\"tp\"], acc[\"fp\"], acc[\"fn\"]\n    dice = (2 * tp + eps) / (2 * tp + fp + fn + eps)\n    iou = (tp + eps) / (tp + fp + fn + eps)\n    prec = (tp + eps) / (tp + fp + eps)\n    rec = (tp + eps) / (tp + fn + eps)\n    return dice, iou, prec, rec\n\n_a = accumulate((_y - 0.5) * 20, _y, new_acc()); _d, _u, _pr, _rc = metrics_from(_a)\nprint(\"perfect -> Dice\", [round(v, 3) for v in _d.tolist()], \"| IoU\", [round(v, 3) for v in _u.tolist()])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:11.149349Z","iopub.execute_input":"2026-10-24T18:32:11.149645Z","iopub.status.idle":"2026-10-24T18:32:11.162486Z","shell.execute_reply.started":"2026-10-24T18:32:11.149626Z","shell.execute_reply":"2026-10-24T18:32:11.161717Z"}},"outputs":[{"name":"stdout","text":"perfect -> Dice [1.0, 1.0, 1.0] | IoU [1.0, 1.0, 1.0]\n","output_type":"stream"}],"execution_count":10},{"id":"0075301c-6941-4e61-981b-9335d7920b1e","cell_type":"markdown","source":"## Training function\n**Adadelta** (lr 1e-3, wd 1e-3), Dice loss, mixed precision. Callbacks: **best-checkpoint** (val Dice), **early stopping** (patience 15), **ReduceLROnPlateau** (factor 0.5, patience 4, min_lr 1e-7), **CSV log**, **NaN guard**, **time budget**.","metadata":{}},{"id":"ecfe0d4d-e670-4eae-ab6d-c1fb2b0e8d27","cell_type":"code","source":"def train_model(model, tr_loader, va_loader, device, run_dir):\n    torch.backends.cudnn.benchmark = True\n    loss_fn = DiceLoss()\n    opt = torch.optim.Adadelta(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n    sched = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, mode=\"min\", factor=RLROP_FACTOR, patience=RLROP_PATIENCE, min_lr=MIN_LR)\n    amp = device.type == \"cuda\"; scaler = torch.amp.GradScaler(\"cuda\", enabled=amp)\n    csv_path = os.path.join(run_dir, \"training_log.csv\"); best_path = os.path.join(run_dir, \"best_model.pt\")\n    with open(csv_path, \"w\", newline=\"\") as f:\n        csv.writer(f).writerow([\"epoch\", \"train_loss\", \"val_loss\", \"val_dice\", \"val_iou\", \"lr\"])\n    hist = {k: [] for k in [\"train\", \"val\", \"dice\", \"iou\"]}\n    info = {\"best_epoch\": 0, \"best_dice\": -1.0, \"best_row\": {}, \"stop_reason\": \"max_epochs\", \"total_epochs\": 0}\n    no_improve = 0\n\n    for ep in range(1, EPOCHS + 1):\n        if time.time() > DEADLINE:\n            info[\"stop_reason\"] = \"time_budget\"; print(\"Time budget reached - stopping this run (best weights are kept).\"); break\n        model.train(); run = 0.0; seen = 0; nan_hit = False\n        for x, y in tr_loader:\n            x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True)\n            with torch.amp.autocast(\"cuda\", enabled=amp):\n                loss = loss_fn(model(x), y)\n            if not torch.isfinite(loss):                    # NaN guard\n                nan_hit = True; break\n            opt.zero_grad(set_to_none=True); scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n            run += loss.item() * x.size(0); seen += x.size(0)\n        if nan_hit:\n            info[\"stop_reason\"] = \"nan\"; print(\"Non-finite loss - stopping this run.\"); break\n        tr_loss = run / max(seen, 1)\n\n        model.eval(); run = 0.0; acc = new_acc()\n        with torch.no_grad():\n            for x, y in va_loader:\n                x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True)\n                with torch.amp.autocast(\"cuda\", enabled=amp):\n                    logits = model(x); loss = loss_fn(logits, y)\n                run += loss.item() * x.size(0); acc = accumulate(logits.float(), y, acc)\n        va_loss = run / len(va_loader.dataset)\n        dice, iou, _, _ = metrics_from(acc); mdice, miou = dice.mean().item(), iou.mean().item()\n        sched.step(va_loss)                                  # ReduceLROnPlateau on val loss\n        lr_now = opt.param_groups[0][\"lr\"]\n        for k, v in zip(hist, [tr_loss, va_loss, mdice, miou]): hist[k].append(v)\n        with open(csv_path, \"a\", newline=\"\") as f:\n            csv.writer(f).writerow([ep, f\"{tr_loss:.5f}\", f\"{va_loss:.5f}\", f\"{mdice:.5f}\", f\"{miou:.5f}\", f\"{lr_now:.2e}\"])\n\n        if mdice > info[\"best_dice\"]:\n            info.update(best_dice=mdice, best_epoch=ep, best_row={\"train_loss\": tr_loss, \"val_loss\": va_loss, \"val_dice\": mdice, \"val_iou\": miou, \"lr\": lr_now})\n            no_improve = 0\n            torch.save({\"model\": model.state_dict(), \"base\": BASE_FILTERS, \"in_ch\": IN_CHANNELS, \"out_ch\": OUT_CHANNELS, \"epoch\": ep}, best_path)\n            star = \"  <- best saved\"\n        else:\n            no_improve += 1; star = f\"  (no improve {no_improve}/{PATIENCE})\"\n        print(f\"Epoch {ep:03d}/{EPOCHS} | train {tr_loss:.4f} | val {va_loss:.4f} | val Dice {mdice:.3f} | val IoU {miou:.3f} | lr {lr_now:.1e}{star}\")\n        if no_improve >= PATIENCE:\n            info[\"stop_reason\"] = \"early_stopping\"\n            print(f\"\\nEarly stopping at epoch {ep}. Best weights: epoch {info['best_epoch']}.\"); break\n\n    info[\"total_epochs\"] = len(hist[\"train\"])\n    if hist[\"train\"]:\n        ep_range = range(1, len(hist[\"train\"]) + 1)\n        fig, ax = plt.subplots(1, 2, figsize=(11, 4))\n        ax[0].plot(ep_range, hist[\"train\"], label=\"train loss\"); ax[0].plot(ep_range, hist[\"val\"], label=\"val loss\")\n        ax[0].set_title(\"Dice loss\"); ax[0].set_xlabel(\"epoch\"); ax[0].legend()\n        ax[1].plot(ep_range, hist[\"dice\"], label=\"val Dice\"); ax[1].plot(ep_range, hist[\"iou\"], label=\"val IoU\")\n        ax[1].set_title(\"Validation metrics\"); ax[1].set_xlabel(\"epoch\"); ax[1].legend()\n        plt.tight_layout(); plt.savefig(os.path.join(run_dir, \"training_curves.png\"), dpi=120); plt.show()\n    print(f\"Best mean val Dice: {info['best_dice']:.3f} (epoch {info['best_epoch']}) | stop: {info['stop_reason']}\")\n    return info","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:11.163622Z","iopub.execute_input":"2026-10-24T18:32:11.16401Z","iopub.status.idle":"2026-10-24T18:32:11.180916Z","shell.execute_reply.started":"2026-10-24T18:32:11.163969Z","shell.execute_reply":"2026-10-24T18:32:11.180092Z"}},"outputs":[],"execution_count":11},{"id":"178931a9-4f6b-4a68-9627-958b4acad0b8","cell_type":"markdown","source":"## Evaluation, visualisation and logging helpers\nTest metrics (Dice, IoU, Precision, Recall, HD95), prediction plot, params / FLOPs / inference time / GPU memory, and the per-seed experiment row.","metadata":{}},{"id":"921b5cd5-501b-4ec0-8393-7fa097d6d4b1","cell_type":"code","source":"def _hd95_2d(pred, gt):\n    \"\"\"95th-percentile symmetric surface distance in pixels (None if either mask is empty).\"\"\"\n    try:\n        from scipy.ndimage import binary_erosion, distance_transform_edt\n    except Exception:\n        return None\n    pred = pred.astype(bool); gt = gt.astype(bool)\n    if pred.sum() == 0 or gt.sum() == 0:\n        return None\n    sp = pred ^ binary_erosion(pred); sg = gt ^ binary_erosion(gt)\n    if sp.sum() == 0 or sg.sum() == 0:\n        return None\n    dt_g = distance_transform_edt(~sg); dt_p = distance_transform_edt(~sp)\n    return float(np.percentile(np.concatenate([dt_g[sp], dt_p[sg]]), 95))\n\n@torch.no_grad()\ndef evaluate(model, loader, device, with_hd95=False):\n    model.eval(); acc = new_acc(); hd = [[] for _ in REGIONS]; amp = device.type == \"cuda\"\n    for x, y in loader:\n        x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\", enabled=amp):\n            logits = model(x)\n        logits = logits.float(); acc = accumulate(logits, y, acc)\n        if with_hd95:\n            p = (torch.sigmoid(logits) > 0.5).cpu().numpy().astype(np.uint8)\n            g = y.cpu().numpy().astype(np.uint8)\n            for b in range(p.shape[0]):\n                for r in range(len(REGIONS)):\n                    h = _hd95_2d(p[b, r], g[b, r])\n                    if h is not None: hd[r].append(h)\n    dice, iou, prec, rec = [t.tolist() for t in metrics_from(acc)]\n    hd95 = [float(np.mean(v)) if len(v) else float(\"nan\") for v in hd]\n    return {\"dice\": dice, \"iou\": iou, \"prec\": prec, \"rec\": rec, \"hd95\": hd95}\n\ndef print_results(res, title):\n    print(f\"\\n================= {title} =================\")\n    print(\"Region |  Dice  |  IoU   | Precision | Recall |  HD95\")\n    print(\"-------+--------+--------+-----------+--------+-------\")\n    for i, r in enumerate(REGIONS):\n        print(f\"{r:6s} | {res['dice'][i]:.3f}  | {res['iou'][i]:.3f}  |   {res['prec'][i]:.3f}   | {res['rec'][i]:.3f}  | {res['hd95'][i]:.2f}\")\n    print(f\"{'Mean':6s} | {np.mean(res['dice']):.3f}  | {np.mean(res['iou']):.3f}  |   {np.mean(res['prec']):.3f}   | {np.mean(res['rec']):.3f}  |\")\n\ndef visualize(model, ids, run_dir, n_show=6):\n    model.eval(); ids = list(ids); random.Random(0).shuffle(ids); picks = []\n    for sid in ids:\n        if np.load(os.path.join(msk_dir, sid + \".npy\"))[0].sum() > 50: picks.append(sid)\n        if len(picks) >= n_show: break\n    if not picks:\n        print(\"No tumor slices found in the test split to show.\"); return\n    fig, axes = plt.subplots(len(picks), 3, figsize=(9, 3 * len(picks)))\n    if len(picks) == 1: axes = axes[None, :]\n    for r, sid in enumerate(picks):\n        x = np.load(os.path.join(img_dir, sid + \".npy\")).astype(np.float32)\n        y = np.load(os.path.join(msk_dir, sid + \".npy\")).astype(np.float32)\n        with torch.no_grad(), torch.amp.autocast(\"cuda\", enabled=(device.type == \"cuda\")):\n            pred = (torch.sigmoid(model(torch.from_numpy(x).unsqueeze(0).to(device)).float())[0, 0] > 0.5).cpu().numpy()\n        gt = y[0]; flair = x[0]; d = (2 * (pred * gt).sum() + 1e-6) / (pred.sum() + gt.sum() + 1e-6)\n        axes[r, 0].imshow(flair, cmap=\"gray\"); axes[r, 0].set_title(\"FLAIR\")\n        axes[r, 1].imshow(flair, cmap=\"gray\"); axes[r, 1].imshow(gt, alpha=0.4, cmap=\"Reds\"); axes[r, 1].set_title(\"Ground truth (WT)\")\n        axes[r, 2].imshow(flair, cmap=\"gray\"); axes[r, 2].imshow(pred, alpha=0.4, cmap=\"Reds\"); axes[r, 2].set_title(f\"Prediction (Dice {d:.2f})\")\n        for a in axes[r]: a.axis(\"off\")\n    fig.tight_layout(); fig.savefig(os.path.join(run_dir, \"predictions.png\"), dpi=120); plt.show()\n\ndef profile_model(m, device):\n    \"\"\"Params, FLOPs (thop = MACs if installed, else torch FlopCounterMode = 2 x MACs), inference time, peak GPU memory.\"\"\"\n    m = m.eval()\n    params_M = sum(p.numel() for p in m.parameters()) / 1e6\n    dummy = torch.randn(1, IN_CHANNELS, IMG_SIZE, IMG_SIZE, device=device)\n    flops_G = float(\"nan\")\n    try:\n        from thop import profile as thop_profile\n        _f, _ = thop_profile(copy.deepcopy(m), inputs=(dummy,), verbose=False)\n        flops_G = _f / 1e9\n    except Exception:\n        try:\n            from torch.utils.flop_counter import FlopCounterMode\n            with torch.no_grad(), FlopCounterMode(display=False) as fc:\n                m(dummy)\n            flops_G = fc.get_total_flops() / 1e9\n        except Exception:\n            pass\n    with torch.no_grad():\n        for _ in range(5): m(dummy)                                  # warm-up\n        if device.type == \"cuda\": torch.cuda.synchronize()\n        t0 = time.time(); N = 50\n        for _ in range(N): m(dummy)\n        if device.type == \"cuda\": torch.cuda.synchronize()\n        infer_ms = (time.time() - t0) / N * 1000.0\n    gpu_mem_MB = float(\"nan\")\n    if device.type == \"cuda\":\n        torch.cuda.reset_peak_memory_stats()\n        with torch.no_grad(): m(dummy)\n        torch.cuda.synchronize(); gpu_mem_MB = torch.cuda.max_memory_allocated() / 1e6\n    return {\"params_M\": params_M, \"flops_G\": flops_G, \"infer_ms\": infer_ms, \"gpu_mem_MB\": gpu_mem_MB}\n\ndef _r(v, nd=4):\n    return round(float(v), nd) if v == v else \"NA\"\n\ndef make_row(seed, res, prof, info, train_time, counts):\n    br = info[\"best_row\"]; nan = float(\"nan\")\n    row = {\n        \"timestamp\": datetime.datetime.now().isoformat(timespec=\"seconds\"),\n        \"model\": MODEL_NAME, \"optimizer\": OPTIMIZER, \"seed\": seed,\n        \"num_patients\": NUM_PATIENTS, \"train_val_test_patients\": f\"{counts['train']}/{counts['val']}/{counts['test']}\",\n        \"base_filters\": BASE_FILTERS, \"weight_decay\": WEIGHT_DECAY, \"lr_init\": LR,\n        \"params_M\": _r(prof[\"params_M\"], 3), \"FLOPs_G\": _r(prof[\"flops_G\"], 3),\n        \"infer_ms\": _r(prof[\"infer_ms\"], 3), \"gpu_mem_MB\": _r(prof[\"gpu_mem_MB\"], 1),\n        \"convergence_epoch\": info[\"best_epoch\"], \"total_epochs\": info[\"total_epochs\"], \"stop_reason\": info[\"stop_reason\"],\n        \"train_time_s\": round(train_time, 1),\n        \"train_loss\": _r(br.get(\"train_loss\", nan), 5), \"val_loss\": _r(br.get(\"val_loss\", nan), 5),\n        \"val_dice\": _r(br.get(\"val_dice\", nan), 5), \"val_iou\": _r(br.get(\"val_iou\", nan), 5), \"lr_at_best\": br.get(\"lr\", nan),\n    }\n    for name, key in [(\"Dice\", \"dice\"), (\"IoU\", \"iou\"), (\"Prec\", \"prec\"), (\"Rec\", \"rec\"), (\"HD95\", \"hd95\")]:\n        for j, rg in enumerate(REGIONS):\n            row[f\"{rg}_{name}\"] = _r(res[key][j], 3 if name == \"HD95\" else 4)\n    for name, key in [(\"Dice\", \"dice\"), (\"IoU\", \"iou\"), (\"Prec\", \"prec\"), (\"Rec\", \"rec\")]:\n        row[f\"Mean_{name}\"] = _r(np.mean(res[key]))\n    return row\n\ndef append_experiment_row(row):\n    csv_out = os.path.join(OUT_DIR, \"experiments.csv\")\n    write_header = not os.path.exists(csv_out)\n    with open(csv_out, \"a\", newline=\"\") as f:\n        w = csv.DictWriter(f, fieldnames=list(row.keys()))\n        if write_header: w.writeheader()\n        w.writerow(row)\n    try:\n        from openpyxl import Workbook, load_workbook\n        xlsx_out = os.path.join(OUT_DIR, \"experiments.xlsx\")\n        if os.path.exists(xlsx_out):\n            wb = load_workbook(xlsx_out); ws = wb.active\n        else:\n            wb = Workbook(); ws = wb.active; ws.append(list(row.keys()))\n        ws.append(list(row.values())); wb.save(xlsx_out)\n    except Exception as e:\n        print(\"openpyxl not available - CSV saved instead:\", e)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:11.182058Z","iopub.execute_input":"2026-10-24T18:32:11.182318Z","iopub.status.idle":"2026-10-24T18:32:11.211531Z","shell.execute_reply.started":"2026-10-24T18:32:11.1823Z","shell.execute_reply":"2026-10-24T18:32:11.210775Z"}},"outputs":[],"execution_count":12},{"id":"cfbaba33-6be4-400c-a020-f38c5b5d4a28","cell_type":"markdown","source":"## Run all seeds\nFor every seed: patient split -> train -> load best checkpoint -> test (+HD95) -> plots -> log row. Each finished seed is saved immediately (`result.json`), so an interrupted session can be re-run and will skip completed seeds.","metadata":{}},{"id":"10771851-addf-47c1-ad21-022cd674bba9","cell_type":"code","source":"results = []; seed_times = []\nfor seed in SEEDS:\n    run_dir = os.path.join(OUT_DIR, f\"{EXP_TAG}_seed{seed}\"); os.makedirs(run_dir, exist_ok=True)\n    res_path = os.path.join(run_dir, \"result.json\"); best_path = os.path.join(run_dir, \"best_model.pt\")\n    if os.path.exists(res_path) and not FORCE_RERUN:\n        results.append(json.load(open(res_path))); print(f\"[seed {seed}] already finished -> loaded {res_path}\"); continue\n    if seed_times and (DEADLINE - time.time()) < 1.1 * max(seed_times):\n        print(f\"[seed {seed}] skipped: not enough time budget left (TIME_BUDGET_HOURS={TIME_BUDGET_HOURS}).\"); continue\n\n    print(\"\\n\" + \"=\" * 22 + f\" SEED {seed} \" + \"=\" * 22)\n    t_seed = time.time()\n    set_seed(seed)\n    splits, counts = make_splits(pool, seed)\n    print(f\"Patients train/val/test: {counts['train']}/{counts['val']}/{counts['test']} | slices: {len(splits['train'])}/{len(splits['val'])}/{len(splits['test'])}\")\n    train_loader, val_loader, test_loader = make_loaders(splits, seed)\n    model = build_model()\n    info = train_model(model, train_loader, val_loader, device, run_dir)\n    train_time = time.time() - t_seed\n    if not os.path.exists(best_path):\n        print(f\"[seed {seed}] no checkpoint was saved (training failed) -> skipping.\"); continue\n\n    ckpt = torch.load(best_path, map_location=device)\n    model.load_state_dict(ckpt[\"model\"]); model.eval()\n    res = evaluate(model, test_loader, device, with_hd95=True)\n    print_results(res, f\"TEST RESULTS (seed {seed}, best epoch {ckpt['epoch']})\")\n    visualize(model, splits[\"test\"], run_dir)\n    prof = profile_model(model, device)\n    row = make_row(seed, res, prof, info, train_time, counts)\n    append_experiment_row(row)\n    json.dump(row, open(res_path, \"w\"))\n    results.append(row); seed_times.append(time.time() - t_seed)\n    print(f\"[seed {seed}] done in {(time.time() - t_seed) / 60:.1f} min | elapsed total {(time.time() - START_TIME) / 3600:.2f} h\")\n\n    del model, train_loader, val_loader, test_loader, ckpt\n    gc.collect()\n    if device.type == \"cuda\": torch.cuda.empty_cache()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T18:32:11.212473Z","iopub.execute_input":"2026-10-24T18:32:11.212748Z"}},"outputs":[{"name":"stdout","text":"\n====================== SEED 42 ======================\nPatients train/val/test: 150/50/50 | slices: 11070/3725/3573\nEpoch 001/200 | train 0.9670 | val 0.9621 | val Dice 0.053 | val IoU 0.028 | lr 1.0e-03  <- best saved\nEpoch 002/200 | train 0.9637 | val 0.9594 | val Dice 0.069 | val IoU 0.036 | lr 1